<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StoryWeaver.Desktop.DesktopApplication">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.secondary">
      <!-- Inherit the containing control's foreground, including selection colours.
           Secondary emphasis must not replace its theme-aware text colour. -->
      <Setter Property="Opacity" Value="0.8" />
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button.entityLink">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
    </Style>
  </Application.Styles>
</Application>
