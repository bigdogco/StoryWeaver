<Page x:Class="StoryWeaver.Uno.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:StoryWeaver.Uno"
      xmlns:us="using:Uno.Simple"
      Background="{ThemeResource BackgroundBrush}">
  <Grid Padding="18" RowSpacing="12" ColumnSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="3*" />
      <ColumnDefinition Width="380" />
    </Grid.ColumnDefinitions>

    <Grid Grid.ColumnSpan="2" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Spacing="2">
        <TextBlock Text="StoryWeaver"
                   FontSize="24"
                   FontWeight="SemiBold" />
        <TextBlock x:Name="HeaderDetailText"
                   Text="Opening session..."
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>

      <Border Grid.Column="1"
              BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="10,6"
              VerticalAlignment="Center">
        <TextBlock x:Name="StatusPillText"
                   Text="Starting"
                   FontWeight="SemiBold" />
      </Border>
    </Grid>

    <Border Grid.Row="1"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="16">
      <Grid RowSpacing="12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="2">
            <TextBlock x:Name="NarrationHeading"
                       Text="Opening session..."
                       FontSize="18"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="TurnText"
                       Text="Turn --"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="8"
                      VerticalAlignment="Top">
            <Button x:Name="StateButton"
                    Content="State"
                    Click="StateButton_Click"
                    IsEnabled="False" />
            <Button x:Name="ProseButton"
                    Content="Prose"
                    Click="ProseButton_Click"
                    IsEnabled="False" />
          </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1">
          <StackPanel x:Name="StoryItems" Spacing="12">
            <TextBlock x:Name="OpeningText"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="ScenarioText"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Grid.Column="1"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="14">
      <Grid RowSpacing="12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
          <TextBlock x:Name="ExplorerHeading"
                     Text="Scene"
                     FontSize="18"
                     FontWeight="SemiBold" />
          <TextBlock x:Name="SaveText"
                     Text="Save --"
                     TextWrapping="Wrap"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
          <Button x:Name="RefreshButton"
                  Content="Refresh"
                  Click="RefreshButton_Click"
                  IsEnabled="False" />
        </StackPanel>

        <ScrollViewer Grid.Row="2">
          <StackPanel x:Name="ExplorerItems" Spacing="10" />
        </ScrollViewer>

        <StackPanel Grid.Row="3" Spacing="4">
          <TextBlock Text="Status"
                     FontWeight="SemiBold" />
          <TextBlock x:Name="SpikeStatusText"
                     Text="Loading..."
                     TextWrapping="Wrap"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Grid.ColumnSpan="2"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="12">
      <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="PlayerInputBox"
                 Header="Player action"
                 PlaceholderText="Type speech, action, or pick a suggested move"
                 IsEnabled="False"
                 KeyDown="PlayerInputBox_KeyDown" />
        <Button Grid.Column="1"
                x:Name="SendButton"
                Content="Send"
                IsEnabled="False"
                Click="SendButton_Click"
                VerticalAlignment="Bottom" />
      </Grid>
    </Border>
  </Grid>
</Page>
