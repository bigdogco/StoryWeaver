<Page x:Class="StoryWeaver.Uno.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:StoryWeaver.Uno"
      xmlns:us="using:Uno.Simple"
      Background="{ThemeResource BackgroundBrush}">
  <Grid Padding="18" RowSpacing="12" ColumnSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2*" />
      <ColumnDefinition Width="420" />
    </Grid.ColumnDefinitions>

    <StackPanel Grid.ColumnSpan="2" Spacing="4">
      <TextBlock Text="StoryWeaver Uno Spike"
                 FontSize="22"
                 FontWeight="SemiBold" />
      <TextBlock Text="Desktop Skia shell for Windows, Linux and macOS. Static UI only; gameplay stays behind StoryWeaver.App and Core."
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>

    <Border Grid.Row="1"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="16">
      <Grid RowSpacing="14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Narration"
                   FontSize="16"
                   FontWeight="SemiBold" />

        <ScrollViewer Grid.Row="1">
          <StackPanel Spacing="14">
            <TextBlock TextWrapping="Wrap"
                       Text="Rain needles the market awnings as Hald watches the alley mouth. The brass key in your palm is warm from being held too tightly." />
            <TextBlock TextWrapping="Wrap"
                       Text="Mabb lowers her voice. &quot;If the lock answers to that, the cellar was never sealed for wine.&quot;" />
          </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Header="Player action"
                   PlaceholderText="Type an action for the next turn"
                   IsEnabled="False" />
          <Button Grid.Column="1"
                  Content="Send"
                  IsEnabled="False"
                  VerticalAlignment="Bottom" />
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Grid.Column="1"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="14">
      <Grid RowSpacing="12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Explorer"
                   FontSize="16"
                   FontWeight="SemiBold" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
          <Button Content="Player" IsEnabled="False" />
          <Button Content="Canon" IsEnabled="False" />
          <Button Content="Issues" IsEnabled="False" />
        </StackPanel>

        <ScrollViewer Grid.Row="2">
          <StackPanel Spacing="10">
            <Border BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10">
              <StackPanel Spacing="3">
                <TextBlock Text="Player"
                           FontWeight="SemiBold" />
                <TextBlock Text="Location: Marrow Market"
                           TextWrapping="Wrap" />
                <TextBlock Text="Knows: cellar key, Shurus cult"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10">
              <StackPanel Spacing="3">
                <TextBlock Text="Marrow Market"
                           FontWeight="SemiBold" />
                <TextBlock Text="Connections: tavern, alley, old cellar"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Spacing="4">
          <TextBlock Text="Spike status"
                     FontWeight="SemiBold" />
          <TextBlock Text="Builds as Uno Skia Desktop. Linux support still needs a Linux machine or CI check."
                     TextWrapping="Wrap"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Page>
