<Page x:Class="StoryWeaver.Uno.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:StoryWeaver.Uno"
      xmlns:us="using:Uno.Simple"
      Background="{ThemeResource BackgroundBrush}">
  <Grid Padding="18" RowSpacing="12" ColumnSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2*" />
      <ColumnDefinition Width="420" />
    </Grid.ColumnDefinitions>

    <StackPanel Grid.ColumnSpan="2" Spacing="4">
      <TextBlock Text="StoryWeaver Uno Spike"
                 FontSize="22"
                 FontWeight="SemiBold" />
      <TextBlock x:Name="HeaderDetailText"
                 Text="Desktop Skia shell for Windows. Sessions open through StoryWeaver.App; gameplay stays behind Core."
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>

    <Border Grid.Row="1"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="16">
      <Grid RowSpacing="14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="NarrationHeading"
                   Text="Opening session..."
                   FontSize="16"
                   FontWeight="SemiBold" />

        <ScrollViewer Grid.Row="1">
          <StackPanel x:Name="StoryItems" Spacing="14">
            <TextBlock x:Name="OpeningText"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="ScenarioText"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="PlayerInputBox"
                   Header="Player action"
                   PlaceholderText="Type an action for the next turn"
                   IsEnabled="False"
                   KeyDown="PlayerInputBox_KeyDown" />
          <Button Grid.Column="1"
                  x:Name="SendButton"
                  Content="Send"
                  IsEnabled="False"
                  Click="SendButton_Click"
                  VerticalAlignment="Bottom" />
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Grid.Column="1"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="14">
      <Grid RowSpacing="12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="ExplorerHeading"
                   Text="Session"
                   FontSize="16"
                   FontWeight="SemiBold" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
          <Button x:Name="RefreshButton"
                  Content="Refresh"
                  Click="RefreshButton_Click"
                  IsEnabled="False" />
          <Button x:Name="StateButton"
                  Content="State"
                  Click="StateButton_Click"
                  IsEnabled="False" />
          <Button x:Name="ProseButton"
                  Content="Prose"
                  Click="ProseButton_Click"
                  IsEnabled="False" />
        </StackPanel>

        <ScrollViewer Grid.Row="2">
          <StackPanel x:Name="ExplorerItems" Spacing="10" />
        </ScrollViewer>

        <StackPanel Grid.Row="3" Spacing="4">
          <TextBlock Text="Spike status"
                     FontWeight="SemiBold" />
          <TextBlock x:Name="SpikeStatusText"
                     Text="Loading pack data..."
                     TextWrapping="Wrap"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Page>
